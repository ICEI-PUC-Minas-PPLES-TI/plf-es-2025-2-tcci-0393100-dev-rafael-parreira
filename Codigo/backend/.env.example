PORT=3001
JWT_SECRET=change_this_secret

# ── MongoDB ───────────────────────────────────────────────────────────────────
# URI de conexão. Padrão: mongodb://localhost:27017
# MONGODB_URI=mongodb://localhost:27017
# Nome do banco. Padrão: stream_sentry
# MONGODB_DB=stream_sentry

# Puppeteer (run-audit.mjs): PUPPETEER_HEADFUL=1, AUDIT_PAGE_DWELL_MS=45000, PUPPETEER_DISABLE_QUIC=1
# O backend liga Worker Threads por padrão para vários usuários; para depurar no mesmo event loop: STREAM_SENTRY_WORKER_THREADS=0
# Se o Chromium mostrar "Não seguro" / erro de certificado no meet.jit.si (antivírus, inspeção HTTPS): PUPPETEER_IGNORE_HTTPS_ERRORS=1
#
# ── Jitsi ────────────────────────────────────────────────────────────────────
# URL base do servidor Jitsi usado pelo botão "Gerar sala Jitsi" no frontend.
# Padrão: meet.jit.si. Para self-hosted: https://jitsi.seudominio.com
# JITSI_BASE_URL=https://meet.jit.si
#
# Nome exibido pelo VU na pré-sala (campo "Display name")
# JITSI_DISPLAY_NAME=Stream Sentry Bot
#
# ── Login Google via perfil Chrome persistente (RECOMENDADO) ──────────────────
# Salva a sessão Google num perfil Chrome reutilizável — funciona mesmo com 2FA.
# Configuração (uma única vez):
#   1. Defina o caminho abaixo (ex.: C:/Users/Pichau/.jitsi-chrome-profile)
#   2. Execute o backend com PUPPETEER_HEADFUL=1 e inicie um teste Jitsi
#   3. No browser que abrir: faça login no Google manualmente
#   4. Encerre o teste → perfil salvo em disco
#   5. Nas próximas execuções o login é automático (cookies reutilizados)
# Cada VU recebe uma cópia independente do perfil (<dir>_vu1, _vu2, ...)
# JITSI_CHROME_PROFILE_DIR=C:/Users/Pichau/.jitsi-chrome-profile
#
# Sempre reivindicar anfitrião após entrar na pré-sala:
# JITSI_CLAIM_HOST=1
#
# ── Login manual (RECOMENDADO para Firebase/Google com 2FA) ──────────────────
# Com PUPPETEER_HEADFUL=1, o bot (VU 1) clica em "Sign in with Google" e pausa
# para você completar o login manualmente na janela do browser.
# Os outros VUs (convidados) entram automaticamente após o anfitrião abrir a sala.
# Padrão: 120s para você fazer o login. Ajuste com JITSI_DEBUG_PAUSE_MS.
# PUPPETEER_HEADFUL=1
# JITSI_DEBUG_PAUSE_MS=120000
#
# ── Login automático com email+senha (alternativa sem 2FA) ────────────────────
# Headless — pode ser bloqueado pelo Google se detectar automação.
# JITSI_AUTH_EMAIL=usuario@gmail.com
# JITSI_AUTH_PASSWORD=sua_senha_ou_app_password
# Formulário na própria página (antes do join, self-hosted): JITSI_AUTH_IN_PAGE=1
# Nunca tocar anfitrião, só convidado: JITSI_GUEST_MODE=1  ou  JITSI_CLAIM_HOST=0
#
# Depuração avançada: pausar após revelar UI de login
# JITSI_DEBUG_LOGIN_UI=1
# JITSI_DEBUG_PAUSE_MS=0
#
# Depois de «Entrar» na pré-sala, o meet mostra «Sou o anfitrião» / I am the host (login Google) — o runner
# procura e clica antes do JITSI_AUTH. Por omissão: ~25s de espera; com JITSI_AUTH_* usa ~90s. Desligar espera: =0
# JITSI_HOST_BUTTON_WAIT_SEC=0
# JITSI_HOST_BUTTON_WAIT_SEC=120
# Se o texto do botão for raro, subcadeia: JITSI_HOST_BUTTON_CONTAINS=anfitri
# Após o clique «Sou o anfitrião» (abre o Google) e após o login automático, espera extra para a sala ligar
# JITSI_POST_HOST_AUTH_DELAY_MS=5000

# Zoom: links públicos são best-effort; páginas com Zoom Meeting SDK são mais estáveis.
# ZOOM_DISPLAY_NAME=Stream Sentry Bot
# ZOOM_PASSCODE=
# ZOOM_USE_ACCESS_TOKEN_AS_PASSCODE=0

# ── Whereby ──────────────────────────────────────────────────────────────────
# Obtenha a chave em https://whereby.whereby.com/org → Developers → API keys
# Necessária para criar salas via POST /platform/whereby/create-room
# WHEREBY_API_KEY=your_whereby_api_key_here
#
# Nome exibido pelo VU ao entrar na sala (pré-sala Whereby)
# WHEREBY_DISPLAY_NAME=Stream Sentry Bot
