@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

' Hierarquia de atores: todos herdam a autenticação do Usuário do Sistema
actor "Usuário do Sistema" as User
actor "Desenvolvedor React" as Dev
actor "Engenheiro de QA" as QA
actor "Tech Lead" as TechLead

User <|-- Dev
User <|-- QA
User <|-- TechLead

' Ordena os atores verticalmente para levar o Usuário do Sistema (e o UC01) ao topo
User -[hidden]down- Dev
Dev -[hidden]down- QA
QA -[hidden]down- TechLead

rectangle "Stream Sentry - Sistema de Testes E2E" {

    usecase "UC01: Realizar Autenticação" as UC01

    package "Módulo de Simulação" {
        usecase "UC02: Configurar Teste" as UC02
        usecase "UC03: Selecionar Provedor" as UC03
        usecase "UC04: Simular Múltiplos\nUsuários Virtuais" as UC04
        usecase "UC05: Injetar Instabilidade\nde Rede" as UC05
        usecase "UC06: Executar Smoke Test" as UC06
        usecase "UC07: Iniciar Teste" as UC07
    }

    package "Módulo de Monitoramento e Controle" {
        usecase "UC08: Monitorar Telemetria\nem Tempo Real" as UC08
        usecase "UC09: Auditar Métricas de\nÁudio e Vídeo" as UC09
        usecase "UC10: Pausar e Retomar Teste" as UC10
        usecase "UC11: Ajustar Concorrência\nao Vivo" as UC11
        usecase "UC12: Finalizar Teste" as UC12
    }

    package "Módulo de Análise" {
        usecase "UC15: Exportar Relatórios" as UC15
        usecase "UC14: Reabrir Auditoria\nde Sessão" as UC14
        usecase "UC13: Consultar Histórico\nde Sessões" as UC13
    }
}

' Autenticação: ligada ao ator genérico (herdada por todos)
User -- UC01

' Desenvolvedor React
Dev -- UC02
Dev -- UC03
Dev -- UC04
Dev -- UC05
Dev -- UC06
Dev -- UC07

' Engenheiro de QA
QA -- UC08
QA -- UC09
QA -- UC10
QA -- UC11
QA -- UC12

' Tech Lead
TechLead -- UC13
TechLead -- UC14
TechLead -- UC15

@enduml
