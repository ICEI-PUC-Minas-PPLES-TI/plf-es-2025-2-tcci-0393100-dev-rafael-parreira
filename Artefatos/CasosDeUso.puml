@startuml
left to right direction
skinparam packageStyle rectangle

actor "Desenvolvedor React" as Dev
actor "Engenheiro de QA" as QA
actor "Equipe Ágil" as Equipe

rectangle "Stream Sentry - Sistema de Testes E2E" {

    ' Foco: Automação e Simulação (Necessidade 1)
    usecase "Configurar Provedores (Strategy Pattern)" as UC_Config
    usecase "Simular Múltiplos Usuários Virtuais" as UC_Simulate
    usecase "Injetar Instabilidade de Rede" as UC_Stress

    ' Foco: Monitoramento e Telemetria (Necessidade 2)
    usecase "Monitorar Telemetria em Tempo Real (WebSockets)" as UC_Live
    usecase "Auditar Métricas de Áudio/Vídeo" as UC_Audit

    ' Foco: Análise e DX (Necessidade 3)
    usecase "Visualizar Histórico e Dashboard" as UC_Dash
    usecase "Exportar Relatórios (JSON/CSV)" as UC_Export
}

' Relacionamentos baseados no Perfil de Usuário do Doc de Visão
Dev --> UC_Config
Dev --> UC_Simulate
Dev --> UC_Stress

QA --> UC_Live
QA --> UC_Audit

Equipe --> UC_Dash
Equipe --> UC_Export

@enduml