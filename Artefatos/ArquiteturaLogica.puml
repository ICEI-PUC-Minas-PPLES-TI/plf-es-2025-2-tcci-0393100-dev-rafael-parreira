@startuml
skinparam componentStyle uml2
skinparam linetype ortho

' Estilização para clareza
skinparam component {
    BackgroundColor #FEFEFE
    BorderColor #222222
}

package "Camada de Interface (React)" #F9F9F9 {
    component [Dashboard Live] as Dash
    component [Configurador] as Config
    component [Analytics] as Analytics
}

package "Camada de Orquestração (Node.js)" #F5F5F5 {
    component [API REST] as REST
    component [WebSocket Hub] as WSHub
    component [Test Engine] as Engine
    component [Report Generator] as RG
}

package "Camada de Execução (Puppeteer)" #F0F0F0 {
    component [Worker Cluster] as Workers
}

database "Camada de Dados" {
    [PostgreSQL] as DB
}

package "Provedores Externos" {
    [WebRTC / Zoom / Jitsi] as External
}

' --- Fluxos de Controle (Setup) ---
Config --> REST : Define parâmetros
REST --> Engine : Inicia execução
Engine --> Workers : Instancia N processos

' --- Fluxos de Telemetria (Hot Path - Tempo Real) ---
Workers .up.> WSHub : Envia métricas raw
WSHub <--> Dash : Broadcast via Socket

' --- Fluxos de Persistência (Cold Path) ---
Workers --> DB : Salva Time-series
RG --> DB : Consulta agregada
Analytics <-- RG : Gera JSON/CSV

' --- Integração Externa ---
Workers <--> External : Sessão de Vídeo
@enduml