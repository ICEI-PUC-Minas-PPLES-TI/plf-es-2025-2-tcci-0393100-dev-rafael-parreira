@startuml
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam rankdir TB
skinparam nodesep 20
skinparam ranksep 30

title Stream Sentry - Arquitetura Lógica (Formato Retrato A4)

package "1. Interface Web (React)" #F9F9F9 {
  component "Views: Landing, Config,\nDashboard, Analytics" as UI
}

package "2. Servidor Core (Go)" #E8F4FC {
  component "API REST (auth, reports)" as REST
  component "Hub WebSocket (telemetria)" as WSHub
  component "Orquestrador de Teste" as Orchestrator
  component "Motor de Relatórios" as Reports

  ' Força os componentes do Go a ficarem um embaixo do outro
  REST -[hidden]down-> WSHub
  WSHub -[hidden]down-> Orchestrator
  Orchestrator -[hidden]down-> Reports
}

package "3. Dados Locais (Ficheiros)" #F5F5E8 {
  component "Utilizadores & Histórico (JSON)" as UserHist
  component "Telemetria (NDJSON)" as TelFiles

  UserHist -[hidden]down-> TelFiles
}

package "4. Runner de Teste (Node.js)" #F0F0F0 {
  component "run-audit.mjs" as Script
  component "Workers (Pool Chromium)" as Workers

  Script -[hidden]down-> Workers
}

package "5. Sistemas Externos" #FFFFFF {
  component "API Alvo (Jitsi, Meet, etc.)" as External
}

' ==========================================
' ESTRUTURA VERTICAL INVISÍVEL
' ==========================================
' Estas linhas forçam os pacotes a se empilharem perfeitamente
UI -[hidden]down-> REST
Reports -[hidden]down-> UserHist
TelFiles -[hidden]down-> Script
Workers -[hidden]down-> External

' ==========================================
' FLUXOS DE COMUNICAÇÃO REAIS
' ==========================================
UI --> REST : HTTP JSON (Config)
UI <--> WSHub : WebSocket Live

REST --> Orchestrator : Comandos (/test/start)
REST --> Reports : Exportações (CSV/JSON)
REST ..> UserHist : Lê/Grava Auth

Orchestrator --> WSHub : Broadcast JSON
Orchestrator --> Script : Spawn Processo Node
Orchestrator ..> TelFiles : Persiste NDJSON
Orchestrator ..> UserHist : Agrega Fim de Teste

Reports ..> TelFiles : Lê NDJSON
Reports ..> UserHist : Lê Histórico

Script ..> Orchestrator : Stdout (Telemetria)
Script --> Workers : Lança Browsers

Workers <--> External : Tráfego WebRTC / getStats()

@enduml