@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam rankdir TB
skinparam nodesep 35
skinparam ranksep 60

title Stream Sentry - Arquitetura Lógica

package "1. Interface Web (React)" #F9F9F9 {
  component "Views: Landing, Autenticação,\nIniciar Teste, Auditoria, Histórico" as UI
}

package "2. Servidor Core (Go)" #E8F4FC {
  component "API REST\n(auth, testes, relatórios)" as REST
  component "Hub WebSocket\n(telemetria)" as WSHub
  component "Orquestrador de Teste" as Orchestrator
  component "Motor de Relatórios" as Reports
}

package "3. Persistência (MongoDB)" #F5F5E8 {
  component "users / test_history" as UserHist
  component "telemetry_events" as TelFiles
}

package "4. Runner de Teste (Node.js)" #F0F0F0 {
  component "run-audit.mjs (pool)" as Script
  component "Workers\n(Chromium / Worker Threads)" as Workers
}

package "5. Sistemas Externos" #FFFFFF {
  component "Salas de Videoconferência\n(Jitsi, Whereby, Zoom)" as External
}

' ── Fluxos (rótulos curtos para evitar sobreposição) ──
UI --> REST : HTTP/JSON
UI <--> WSHub : WebSocket

REST --> Orchestrator : /test/start
REST --> Reports : export
REST ..> UserHist : auth

Orchestrator --> WSHub : broadcast
Orchestrator --> Script : spawn
Orchestrator ..> TelFiles : persiste
Orchestrator ..> UserHist : histórico

Reports ..> TelFiles : lê
Reports ..> UserHist : lê

Script ..> Orchestrator : stdout
Script --> Workers : browsers

Workers <--> External : WebRTC / getStats()

@enduml
