@startuml
skinparam shadowing false
skinparam linetype ortho
title Modelo de Dados (MongoDB) - Stream Sentry

' Coleções do MongoDB (modelo documental)
entity "users" as users {
  id : int <<PK>>
  --
  name : string
  email : string <<unique>>
  password_hash : string
}

entity "counters" as counters {
  _id : string <<PK>>
  --
  seq : int
}

entity "test_history" as hist {
  id : string <<PK>>  (sessionId)
  --
  startedAt : ISODate
  endedAt : ISODate
  durationSec : float
  apiUrl : string
  virtualUsers : int
  chaosProfile : string
  exitOk : bool
  summary : objeto (embutido)
}

entity "telemetry_events" as events {
  sessionId : string <<ref>>
  seq : int
  --
  event : string
  raw : string (NDJSON)
}

' Relacionamento por referência: cada evento aponta para a sessão (sessionId = test_history.id)
hist "1" --o "*" events : sessionId

note right of hist
  summary é um subdocumento embutido
  (TelemetrySessionSummary): agregados
  de HTTP e WebRTC (RTT, jitter, etc.)
end note

note bottom of users
  Coleção usada na autenticação (JWT).
  counters fornece o id incremental de usuário.
end note

@enduml
