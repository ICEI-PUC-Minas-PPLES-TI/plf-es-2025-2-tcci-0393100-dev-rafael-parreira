@startuml
' Recorte 2/2 do diagrama de Casos de Uso para apresentacao.
' Foco: Modulo de Monitoramento (Engenheiro de QA) e Modulo de Analise (Equipe Agil).
' Diagrama completo em CasosDeUso.puml.

top to bottom direction
skinparam dpi 150
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Usuário do Sistema" as User
actor "Engenheiro de QA" as QA
actor "Equipe Ágil" as Equipe

' Herança: ambos os atores são Usuários e herdam a autenticação
User <|-- QA
User <|-- Equipe

rectangle "Stream Sentry - Monitoramento e Análise" {

    usecase "UC00: Realizar Autenticação\n(Registrar/Logar)" as UC_Auth

    package "Módulo de Monitoramento" {
        usecase "UC04: Monitorar Telemetria em\nTempo Real (WebSockets)" as UC_Live
        usecase "UC05: Auditar Métricas de Áudio/Vídeo" as UC_Audit
    }

    package "Módulo de Análise" {
        usecase "UC06: Visualizar Histórico\ne Dashboard" as UC_Dash
        usecase "UC07: Exportar Relatórios\n(JSON/CSV)" as UC_Export
    }

    ' Empilha os use cases numa coluna (reduz a largura para os slides)
    UC_Auth -[hidden]down-> UC_Live
    UC_Live -[hidden]down-> UC_Audit
    UC_Audit -[hidden]down-> UC_Dash
    UC_Dash -[hidden]down-> UC_Export
}

' Apenas o ator genérico aponta para o Login (limpa o emaranhado)
User --> UC_Auth

QA --> UC_Live
QA --> UC_Audit

Equipe --> UC_Dash
Equipe --> UC_Export

@enduml
