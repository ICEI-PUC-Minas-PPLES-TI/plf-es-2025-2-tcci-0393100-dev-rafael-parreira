@startuml
' Diagrama de Componentes (notacao UML): componentes com icone,
' interfaces providas (pirulito) / requeridas (soquete) e dependencias de uso.

skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 60

' ── Interfaces ──
interface "REST" as IREST
interface "WebSocket" as IWS
interface "Sala WebRTC" as IRoom

package "Interface Web (React/TypeScript)" {
  component "App.tsx" as App
  component "AuditDashboard.tsx" as Dash
  component "useTelemetryWS.ts" as WSClient
}

package "Servidor Core (Go)" {
  component "authServer\n(handlers REST)" as Core
  component "telemetryHub\n(Hub WebSocket)" as Hub
  component "db.go\n(acesso MongoDB)" as DBaccess
}

package "Runner (Node.js / Puppeteer)" {
  component "run-audit.mjs" as Runner
  component "ProviderFactory\n«Strategy»" as Factory
}

database "MongoDB\n(users, test_history,\ntelemetry_events)" as Mongo

package "Provedores externos" {
  component "Jitsi"   as Jitsi
  component "Whereby" as Whereby
  component "Zoom"    as Zoom
}

' ── Layout: mantem o frontend acima do Core (conectores curtos) ──
App -[hidden]down-> Core
WSClient -[hidden]down-> Hub

' ── Interfaces providas (pirulito) e requeridas (soquete), com protocolo ──
Core - IREST
App --( IREST : HTTP/HTTPS (TCP/IP)
Hub - IWS
WSClient --( IWS : WebSocket/WSS (TCP/IP)

' ── Dependencias internas (chamadas em processo) ──
Dash ..> WSClient
Core ..> DBaccess

' ── Comunicacoes entre componentes, com protocolo/tecnologia ──
DBaccess ..> Mongo : MongoDB Wire\nProtocol (TCP/IP)
Core ..> Runner : spawn + stdout\n(NDJSON) / control.json
Runner ..> Factory

' ── Strategy: a Factory requer uma Sala WebRTC, provida pelos provedores ──
Factory --( IRoom : HTTPS + WebRTC
Jitsi - IRoom
Whereby - IRoom
Zoom - IRoom

@enduml
