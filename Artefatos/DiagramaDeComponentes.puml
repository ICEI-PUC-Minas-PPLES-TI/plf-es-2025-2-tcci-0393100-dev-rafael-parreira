@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam ranksep 55
skinparam nodesep 40

interface "REST" as IREST
interface "WebSocket" as IWS

package "Interface Web (React/TypeScript)" {
  [App.tsx] as App
  [AuditDashboard.tsx] as Dash
  [useTelemetryWS.ts] as WSClient
}

package "Servidor Core (Go)" {
  [authServer\n(handlers REST)] as Core
  [telemetryHub\n(Hub WebSocket)] as Hub
  [db.go\n(acesso MongoDB)] as DBaccess
}

package "Runner (Node.js / Puppeteer)" {
  [run-audit.mjs] as Runner
  [ProviderFactory\nIConferenceProvider] as Providers
}

database "MongoDB\n(users, test_history,\ntelemetry_events)" as Mongo

package "Provedores externos" {
  [Jitsi]
  [Whereby]
  [Zoom]
}

' Frontend -> Core (interfaces REST e WebSocket)
Dash ..> WSClient
App --> IREST
WSClient --> IWS
IREST -- Core
IWS -- Hub

' Core: persistência e orquestração
Core --> DBaccess
Hub --> DBaccess
DBaccess --> Mongo
Core --> Runner : spawn / stdout

' Runner -> provedores via Strategy/Factory
Runner --> Providers
Providers --> [Jitsi]
Providers --> [Whereby]
Providers --> [Zoom]
@enduml
