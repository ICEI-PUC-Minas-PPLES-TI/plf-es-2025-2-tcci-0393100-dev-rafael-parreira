@startuml
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 18
skinparam ranksep 90
skinparam shadowing false

package "Modelos (Domínio)" {
    class Usuario {
      - id: UUID
      - nome: string
      - email: string
      - funcao: EnumFuncao
    }

    enum EnumFuncao {
      DESENVOLVEDOR_REACT
      ENGENHEIRO_QA
      TECH_LEAD
    }

    enum EnumStatus {
      CONFIGURADO
      EXECUTANDO
      CONCLUIDO
    }

    class Teste {
      - id: UUID
      - apiUrl: string
      - usuariosVirtuais: int
      - duracaoSeg: int
      - status: EnumStatus
      - iniciadoEm: timestamp
      + calcularProgresso(): float
    }

    class Relatorio {
      - id: UUID
      - latenciaMedia: float
      - taxaFalhas: float
      - urlJson: string
      - urlCsv: string
      + consolidarMetricas(): void
    }

    class EventoTelemetria {
      - id: UUID
      - tipo: string
      - timestamp: timestamp
      - payload: JSON
    }

    class MetricasWebRTC {
      - rttMs: float
      - jitter: float
      - perdaPacotes: int
      - bitrate: int
      - framesDecodificados: int
      - resolucao: string
    }

    class PerfilChaos {
      - nome: string
      - latenciaMs: int
      - perdaPercent: float
      - offline: bool
      + aplicar(page): void
    }
}

package "Core (Lógica de Execução)" {
    class AuthService {
      - jwtSecret: string
      + registrar(dados): Usuario
      + logar(email, senha): string
      + validarToken(token): bool
    }

    class TestEngine {
      - usuariosAtivos: List<UsuarioVirtual>
      + iniciarTeste(teste: Teste): void
      + finalizarTeste(): void
      - orquestrarPuppeteer(): void
    }

    class PoolController {
      - alvoUsuarios: int
      - pausado: bool
      + ajustarConcorrencia(n: int): void
      + pausar(): void
      + retomar(): void
    }

    class UsuarioVirtual {
      - instanceId: UUID
      + entrarNaSala(config: JSON): void
      + injetarFalha(perfil: PerfilChaos): void
      + coletarStats(): MetricasWebRTC
    }

    class TelemetryHub {
      - clientes: List<Conexao>
      + registrar(cliente): void
      + broadcast(evento: EventoTelemetria): void
      + notificarConclusao(id: UUID): void
    }

    class RollupAccumulator {
      + adicionarEvento(e: EventoTelemetria): void
      + consolidar(): Relatorio
    }

    class Persistencia {
      + salvarSessao(t: Teste): void
      + salvarEvento(e: EventoTelemetria): void
      + listarHistorico(): List<Teste>
    }
}

package "Integração e Estratégia" {
    class ProviderFactory {
        + {static} createProvider(url: string): IConferenceProvider
    }

    interface IConferenceProvider {
        + {static} matches(url: string): boolean
        + name: string
        + requiresAccessToken(): boolean
        + isMultiPage(): boolean
        + getStats(page, browser): MetricasWebRTC
    }

    class WebRTCProvider implements IConferenceProvider
    class JitsiProvider implements IConferenceProvider
    class WherebyProvider implements IConferenceProvider
    class ZoomProvider implements IConferenceProvider
}

' Tipos enumerados
Usuario ..> EnumFuncao : usa >
Teste ..> EnumStatus : usa >

' Relacionamentos de domínio
Usuario "1" -- "*" Teste : solicita >
Teste "1" -- "0..1" Relatorio : gera >
Teste "1" -- "*" EventoTelemetria : produz >
Teste "1" -- "0..1" PerfilChaos : aplica >
EventoTelemetria "1" ..> "0..1" MetricasWebRTC : carrega >

' Autenticação e persistência
AuthService ..> Usuario : autentica >
AuthService ..> Persistencia : consulta >
Persistencia ..> Teste : persiste >
Persistencia ..> EventoTelemetria : persiste >

' Execução e orquestração
TestEngine "1" *-- "*" UsuarioVirtual : gerencia >
TestEngine ..> PoolController : lê controle >
TestEngine ..> TelemetryHub : publica >
TestEngine ..> RollupAccumulator : agrega >
RollupAccumulator ..> EventoTelemetria : consome >
UsuarioVirtual ..> TelemetryHub : telemetria >
UsuarioVirtual ..> MetricasWebRTC : coleta >

' Estratégia de provedores
UsuarioVirtual --> ProviderFactory : usa >
ProviderFactory ..> IConferenceProvider : cria >

' ===== Layout vertical (mais alto e estreito para caber na folha) =====
' Empilha os pacotes verticalmente (ancoras sem conflito de dependencia)
PerfilChaos -[hidden]down- AuthService
Persistencia -[hidden]down- ProviderFactory

' Quebra o Core em 2 colunas (empilhando as classes)
AuthService -[hidden]down- PoolController
PoolController -[hidden]down- UsuarioVirtual
UsuarioVirtual -[hidden]down- Persistencia
TestEngine -[hidden]down- RollupAccumulator
RollupAccumulator -[hidden]down- TelemetryHub

' Provedores em grade 2x2 (em vez de fileira unica)
ZoomProvider -[hidden]down- JitsiProvider
WebRTCProvider -[hidden]down- WherebyProvider

' Empilha os enums numa coluna (evita alargar o pacote Modelos)
Usuario -[hidden]down- EnumFuncao
EnumFuncao -[hidden]down- EnumStatus
@enduml
