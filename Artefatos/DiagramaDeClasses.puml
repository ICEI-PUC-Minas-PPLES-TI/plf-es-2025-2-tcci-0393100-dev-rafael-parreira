@startuml
hide stereotype
skinparam classAttributeIconSize 0

class Usuario {
  - id: int
  - nome: string
  - tipo: string
  + autenticar(): bool
}

class Teste {
  - id: int
  - quantidadeUsuarios: int
  - api: string
  - duracao: int
  - status: string
  - iniciado_em: timestamp
  - concluido_em: timestamp
  + configurar(): void
  + executar(): void
}

class Relatorio {
  - id: int
  - testeId: int
  - metricas: Map<string, float>
  - caminho_arquivo_json: string
  - caminho_arquivo_csv: string
  - gerado_em: timestamp
  + exportar(): void
}

class APIVideoconferencia {
  - tipo: string
  + iniciarSessao(): bool
  + coletarMetricas(): Map<string, float>
}

class ConfiguracaoAPI {
  - id: int
  - endpoint: string
  - token: string
  - max_usuarios_simultaneos: int
}

' Relacionamentos com mais espaços para legibilidade
Usuario "  1  " -- "  * " Teste
Usuario "  1  " -- "  * " ConfiguracaoAPI

Teste "  1  " -- "  1  " Relatorio
Teste ..> APIVideoconferencia : <<usa>>
Teste -- "  1  " ConfiguracaoAPI : <<usa>>

@enduml