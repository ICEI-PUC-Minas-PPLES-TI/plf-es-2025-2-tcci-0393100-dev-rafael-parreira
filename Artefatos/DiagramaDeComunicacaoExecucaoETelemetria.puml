@startuml
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 55

actor "Engenheiro de QA" as QA
rectangle "App\n(App.tsx)" as App
rectangle "authServer\n(main.go)" as Core
rectangle "run-audit.mjs\n(runVirtualUser)" as Runner
rectangle "sala externa\n(meet.jit.si / whereby.com / zoom.us)" as Ext
rectangle "telemetryHub\n(main.go)" as Hub
rectangle "useTelemetryWS\n(hook)" as WS
rectangle "MongoDB\n(telemetry_events)" as DB

QA -- App : 1: iniciarTeste()
App -- Core : 2: POST /test/start [handleTestStart]
Core -- Runner : 3: runAuditTest() (spawn)
Runner -- Ext : 4: collectWebRTCSummary() / getStats()
Runner -- Core : 5: emit webrtc_stats (stdout)
Core -- DB : 6: dbInsertTelemetryEvent()
Core -- Hub : 7: broadcast()
Hub -- WS : 8: push (/ws/telemetry)
@enduml
