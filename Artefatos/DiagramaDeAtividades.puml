@startuml
skinparam shadowing false
skinparam MaxMessageSize 150
skinparam conditionStyle diamond
skinparam orientation horizontal

|Usuário|
start
:Acessar Stream Sentry;
partition "Segurança" {
    if (Autenticado?) then (não)
        :Realizar Login (JWT);
    endif
}

|#GhostWhite|Sistema (Stream Sentry)|
partition "Configuração" {
    :Definir Parâmetros e API;
    :Validar via Strategy Pattern;
    :Persistir Cenário no BD;
}

|#Ivory|Provedores & Workers|
partition "Execução" {
    fork
        :Spawn Workers Puppeteer;
        :Handshake com API Vídeo;
    fork again
        :Abrir WebSocket Hub;
    end fork
}

|Sistema (Stream Sentry)|
partition "Monitoramento & Estresse" {
    while (Duração Ativa?) is (sim)
        :Coletar Métricas;
        fork
            :Update Dashboard (Hot Path);
        fork again
            :Save History (Cold Path);
        end fork

        if (Injetar Instabilidade?) then (sim)
            |Provedores & Workers|
            :Aplicar Network Latency;
            |Sistema (Stream Sentry)|
        endif
    endwhile (não)
}

partition "Finalização" {
    |Provedores & Workers|
    :Teardown das Instâncias;
    |Sistema (Stream Sentry)|
    :Gerar Relatório (JSON/CSV);
}

|Usuário|
:Visualizar Análise Final;
stop
@enduml