@startuml
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 55

actor "Desenvolvedor React" as Dev
rectangle "App\n(App.tsx)" as App
rectangle "authServer\n(main.go)" as Core
rectangle "run-audit.mjs" as Runner

Dev -- App : 1: configura e inicia teste
App -- Core : 2: POST /test/start [handleTestStart]
Core -- Core : 3: validateTechnicalConfig()
Core -- Runner : 4: runAuditTest() (spawn)
Runner -- Runner : 5: ProviderFactory.createProvider() -> IConferenceProvider
@enduml
