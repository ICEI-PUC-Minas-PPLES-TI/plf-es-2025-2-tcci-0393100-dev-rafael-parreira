@startuml
skinparam shadowing false
skinparam nodesep 45
skinparam ranksep 55

actor "Equipe Ágil" as Equipe
rectangle "App\n(App.tsx)" as App
rectangle "authServer\n(handleExportReports)" as Core
rectangle "MongoDB\n(test_history, telemetry_events)" as DB

Equipe -- App : 1: solicita exportação (handleDownloadReport)\n6: download (JSON/CSV)
App -- Core : 2: GET /reports/export
Core -- DB : 3: dbLoadTestHistory() / dbLoadSessionEvents()
Core -- Core : 4: rollup (TelemetrySessionSummary)
Core -- App : 5: stream do arquivo (JSON/CSV)
@enduml
