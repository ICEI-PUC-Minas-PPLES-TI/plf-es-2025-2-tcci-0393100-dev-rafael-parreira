@startuml
hide footbox
skinparam ParticipantPadding 15
skinparam MaxMessageSize 150

actor "Engenheiro de QA" as QA
participant "Interface React\n(TypeScript)" as Web
participant "TestEngine\n(Core API, Go)" as Core
participant "WorkerNode\n(Puppeteer)" as Worker
participant "SocketManager\n(WS Hub)" as Socket
participant "Sala de Vídeo\n(Jitsi/Whereby/Zoom)" as Ext
database "MongoDB" as DB

QA -> Web: Clica em "Iniciar Teste"
activate Web
Web -> Core: POST /test/start
activate Core

Core -> Worker: spawn(config)
activate Worker
Worker -> Ext: Entrar na sala (handshake)
Ext --> Worker: Conexão OK

loop Ciclo de Monitoramento
    Worker -> Ext: getStats() (WebRTC)
    Ext --> Worker: Telemetria raw
    Worker -> Core: Evento 'webrtc_stats' (stdout)
    Core -> DB: Persiste em telemetry_events
    Core -> Socket: broadcast
    Socket -> Web: Push live data (WS)
    Web -> Web: Atualiza gráficos instantaneamente
end

Core -> Worker: terminate()
deactivate Worker
Core -> Socket: broadcast 'test_complete' / 'server_audit_summary'
Socket -> Web: Push (WS)
deactivate Core
Web --> QA: Habilita visualização de relatórios
deactivate Web
@enduml
